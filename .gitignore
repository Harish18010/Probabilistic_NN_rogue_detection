# 1. Python Cache & Compiled Files (Junk files generated by Python)
__pycache__/
*.py[cod]
*$py.class

# 2. Virtual Environments (System-specific, should never be shared)
venv/
env/

# 3. Datasets (GitHub will block .h5 files because they are too large)
data/raw/
data/subsets/
*.h5

# 4. PyTorch Model Weights (Huge binary files)
*.pth

# 5. Generated Artifacts / Plots (Keeps the repo clean)
*.png
*.jpg